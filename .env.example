# Copie para ".env" (que NÃO vai para o git) e preencha com seus valores.

# Backend (Flask) — URL do PostgreSQL. Ex.: Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Backend — chave para assinar os tokens de login (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria

# Frontend (Flet) — URL do backend. Local: http://localhost:5000
API_BASE=http://localhost:5000
